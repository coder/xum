{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "sourceMap": true
  },
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", "**/dist", "**/build", "**/.git"],
    "excludeFiles": ["**/*.d.ts.map"]
  },
  "include": [
    "src/version.ts",
    "src/cli/index.ts",
    "src/cli/run.ts",
    "src/cli/workflow.ts",
    "src/cli/server.ts",
    "src/cli/acp.ts",
    "src/desktop/**/*",
    "src/node/**/*",
    "src/common/**/*"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.testHarness.ts",
    "src/node/services/testHistoryService.ts",
    "src/browser/**/*",
    "src/cli/debug/**/*",
    "src/node/builtinWorkflowActions/**/*",
    "src/node/workflowRuntime/**/*"
  ]
}
