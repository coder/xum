  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.js.map",
    "dist/**/*.wasm",
    "dist/**/*.html",
    "dist/**/*.css",
    "dist/**/*.woff",
    "dist/**/*.woff2",
    "dist/**/*.json",
    "dist/**/*.png",
    "dist/**/*.br",
    "dist/**/*.gz",
    "dist/assets/**/*",
    "dist/*-LICENSE.txt",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "build": {
    "appId": "com.mux.app",
    "productName": "Xum",
    "executableName": "xum",
    "protocols": [
      {
        "name": "Xum",
        "schemes": [
          "xum",
          "mux"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "afterSign": "scripts/notarize-mac.js",
    "files": [
      "dist/**/*"
    ],
    "asarUnpack": [
      "dist/**/*.wasm",
      "dist/**/*.map",
      "**/node_modules/@lydell/**/*",
      "**/node_modules/@duckdb/**/*.node",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/robotjs/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "artifactName": "xum-${version}-${arch}-${os}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "build/icons",
      "artifactName": "xum-${version}-${arch}-${os}.${ext}",
      "desktop": {
        "StartupWMClass": "xum"
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "xum-${version}-${arch}-${os}.${ext}",
      "sign": "scripts/sign-windows.js",
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  },
  "trustedDependencies": [
    "@swc/core",
    "core-js",
    "cpu-features",
    "edgedriver",
    "esbuild",
    "geckodriver",
    "lzma-native",
    "sharp",
    "ssh2",
    "unrs-resolver"
  ],
  "overrides": {
    "sharp": "^0.35.5",
    "@swc/core": "1.15.3"
  },
  "patchedDependencies": {
    "@ai-sdk/xai@4.0.37": "patches/@ai-sdk%2Fxai@4.0.37.patch",
    "trpc-cli@0.12.4": "patches/trpc-cli@0.12.4.patch"
  }
}
