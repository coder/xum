{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/*"],
      "xum/*": ["./src/*"],
      "mux/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.d.ts", "vscode/src/**/*.ts", "vscode/src/**/*.tsx", "scripts/**/*.test.ts"],
  "exclude": ["node_modules", "vscode/node_modules", "dist"]
}
