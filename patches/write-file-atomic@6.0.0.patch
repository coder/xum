-    } else if (data != null) {
-      await promisify(fs.write)(fd, String(data), 0, String(options.encoding || 'utf8'))
-    }
+    const buffer = toBuffer(data, options.encoding)
+    await writeAllAsync(fd, buffer, tmpfile)
 
     if (options.fsync !== false) {
       await promisify(fs.fsync)(fd)
     }
