+// Patched for coder/xum#4197. A single write(2) may accept fewer bytes than requested
+// without reporting an error (for example when the filesystem fills mid-write); upstream
+// discards the returned byte count, so the truncated temp file was fsynced and renamed
+// over the previous good file. Write the whole payload in a loop, then refuse to publish
+// a temp file whose on-disk size differs from the payload.
+function toBuffer (data, encoding) {
+  if (data == null) {
+    return Buffer.alloc(0)
+  }
+  if (ArrayBuffer.isView(data)) {
+    return Buffer.from(data.buffer, data.byteOffset, data.byteLength)
+  }
+  return Buffer.from(String(data), String(encoding || 'utf8'))
+}
+
+function incompleteWriteError (tmpfile, written, expected) {
+  const err = new Error(`Incomplete write to ${tmpfile}: ${written} of ${expected} bytes`)
+  err.code = 'EIO'
+  return err
+}
+
+async function writeAllAsync (fd, buffer, tmpfile) {
+  let offset = 0
+  while (offset < buffer.length) {
+    const written = await new Promise((resolve, reject) => {
+      fs.write(fd, buffer, offset, buffer.length - offset, offset, (err, bytesWritten) => {
+        if (err) {
+          reject(err)
+        } else {
+          resolve(bytesWritten)
+        }
+      })
+    })
+    if (!(written > 0)) {
+      throw incompleteWriteError(tmpfile, offset, buffer.length)
+    }
+    offset += written
+  }
+}
+
+function writeAllSync (fd, buffer, tmpfile) {
+  let offset = 0
+  while (offset < buffer.length) {
+    const written = fs.writeSync(fd, buffer, offset, buffer.length - offset, offset)
+    if (!(written > 0)) {
+      throw incompleteWriteError(tmpfile, offset, buffer.length)
+    }
+    offset += written
+  }
+}
+
+function assertCompleteSize (size, expected, tmpfile) {
+  if (size !== expected) {
+    throw incompleteWriteError(tmpfile, size, expected)
+  }
+}
+
 async function writeFileAsync (filename, data, options = {}) {
   if (typeof options === 'string') {
     options = { encoding: options }
